<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<GridPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.ui.controller.UserDialogController" hgap="8" vgap="8">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10" />
    </padding>
    <Label text="Full Name:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
    <TextField fx:id="txtFullName" GridPane.rowIndex="0" GridPane.columnIndex="1" />

    <Label text="Email:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
    <TextField fx:id="txtEmail" GridPane.rowIndex="1" GridPane.columnIndex="1" />

    <Label text="QR Value:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
    <TextField fx:id="txtQr" GridPane.rowIndex="2" GridPane.columnIndex="1" />

    <Label text="Active:" GridPane.rowIndex="3" GridPane.columnIndex="0" />
    <CheckBox fx:id="chkActive" GridPane.rowIndex="3" GridPane.columnIndex="1" />

    <HBox spacing="8" GridPane.rowIndex="4" GridPane.columnIndex="1" alignment="CENTER_RIGHT">
        <Button text="Cancel" onAction="#onCancel" />
        <Button text="Save" onAction="#onSave" />
    </HBox>
</GridPane>
