<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.PieChart?>
<ScrollPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.ui.controller.DashboardCardsController" fitToWidth="true" styleClass="page-root">
    <content>
        <VBox spacing="12">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10" />
            </padding>
            <children>
                <Label text="Dashboard" style="-fx-font-size:20px; -fx-font-weight:bold;" />
                <FlowPane fx:id="cardsPane" hgap="12" vgap="12" prefWrapLength="800" styleClass="flow-cards">
                    <!-- Cards will be defined here with fx:id so controller can populate -->
                    <children>
                        <!-- Total Users Card -->
                        <VBox spacing="8" styleClass="card" prefWidth="220">
                            <Label text="Ukupno korisnika" style="-fx-font-weight: bold;" />
                            <Label fx:id="lblTotalUsers" text="--" style="-fx-font-size:24px;"/>
                        </VBox>



                        <!-- Currently Signed-in Users Card -->
                        <VBox spacing="8" styleClass="card" prefWidth="360">
                            <Label text="Trenutno prijavljeni" style="-fx-font-weight:bold;" />
                            <ListView fx:id="listSignedIn" prefHeight="140" styleClass="list-view" style="-fx-font-weight: normal" />
                        </VBox>

                        <!-- Today's Attendance Summary -->
                        <VBox spacing="8" styleClass="card" prefWidth="220">
                            <Label text="Današnje prijave" style="-fx-font-weight:bold;" />
                            <Label fx:id="lblTodayCheckins" text="--" style="-fx-font-size:24px;" />
                        </VBox>

                        <!-- Recent Activity -->
                        <VBox spacing="8" styleClass="card" prefWidth="520">
                            <Label text="Nedavne prijave" styleClass="card-header" />
                            <ListView fx:id="listRecent" prefHeight="180" styleClass="list-view" style="-fx-font-weight: normal"/>
                        </VBox>

                        <!-- Role distribution pie chart -->
                        <VBox spacing="8" styleClass="card" prefWidth="360">
                            <Label text="Praktikant / Volonter" style="-fx-font-weight:bold;" />
                            <PieChart fx:id="rolePieChart" prefHeight="200" prefWidth="320" />
                        </VBox>

                    </children>
                </FlowPane>
            </children>
        </VBox>
    </content>
</ScrollPane>
