<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<AnchorPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.ui.controller.AttendanceListController">
    <children>
    <VBox spacing="8" AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0">
        <!-- Page title and role filter -->
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="Sva prisustva" style="-fx-font-size:18px; -fx-font-weight:bold;" />
            <Region HBox.hgrow="ALWAYS" />
            <Region HBox.hgrow="ALWAYS" />
            <Label text="Filter po datumu:" />
            <DatePicker fx:id="dateFilter" />
        </HBox>
        <HBox spacing="8">
        <Button text="Dodaj prisustvo" fx:id="addButton" onAction="#onAdd" />
        <Button text="Eksportuj u PDF" fx:id="exportPdfButton" onAction="#onExportPdf" />
        <Button text="Uredi" fx:id="editButton" onAction="#onEdit" />
        <Button text="Obriši prisustvo" fx:id="deleteButton" onAction="#onDelete" />
        </HBox>
        <TableView fx:id="attendanceTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn text="ID" fx:id="colId" />
                <TableColumn text="Ime" fx:id="colName" />
                <TableColumn text="Datum" fx:id="colDate" />
                <TableColumn text="Vrijeme prijave" fx:id="colCheckIn" />
                <TableColumn text="Početak pauze" fx:id="colPauseIn" />
                <TableColumn text="Kraj pauze" fx:id="colPauseOut" />
                <TableColumn text="Vrijeme odjave" fx:id="colCheckOut" />
                <TableColumn text="Ukupno sati" fx:id="colTotalHours" />
            </columns>
        </TableView>
    </VBox>
    </children>
</AnchorPane>

