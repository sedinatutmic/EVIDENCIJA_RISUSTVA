<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox spacing="10" alignment="CENTER" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.ui.controller.QrScanController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <Label text="Skeniraj QR kod" style="-fx-font-size:16px; -fx-font-weight:bold;" />
    <Button text="Odaberi sliku" fx:id="chooseImageButton" onAction="#onChooseImage" />
    <CheckBox text="Pauza" fx:id="pauseCheckbox" />
    <Label fx:id="resultLabel" wrapText="true" />
</VBox>
