<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.Group?>
<?import javafx.scene.paint.*?>
<?import javafx.scene.image.ImageView?>
<VBox spacing="10" alignment="TOP_CENTER" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.ui.controller.QrScanController" styleClass="page-root scanner-page">
    <padding>
        <Insets top="8" right="16" bottom="16" left="16"/>
    </padding>

    <!-- NOTE: Top navigation is provided by root.fxml (global). Removed duplicate topbar from this page. -->

    <!-- small spacer to visually separate from root topbar if needed -->
    <Region prefHeight="8" />

    <!-- Centered card container -->
    <StackPane HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS" alignment="CENTER">
        <children>
            <AnchorPane prefWidth="900" maxWidth="900" minWidth="300" styleClass="scanner-card-container">
                <children>
                    <VBox alignment="CENTER" spacing="18" AnchorPane.topAnchor="20.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" styleClass="scanner-card card">
                        <children>
                            <!-- Big message label (bound to controller.resultLabel) -->
                            <Label fx:id="resultLabel" text="Molimo skenirajte Vaš QR kod..." wrapText="true" alignment="CENTER" maxWidth="760" styleClass="scanner-message" />

                            <!-- Placeholder and controls area -->
                            <HBox spacing="24" alignment="CENTER" styleClass="scanner-body" >
                                <!-- Visual placeholder (vector shapes) -->
                                <StackPane prefWidth="360" prefHeight="260" styleClass="scanner-placeholder">
                                    <children>
                                        <!-- rounded rectangle frame -->
                                        <Rectangle width="320" height="220" arcWidth="18" arcHeight="18" fill="transparent" stroke="#dfe7ff" strokeWidth="3" />

                                        <!-- corner brackets -->
                                        <Group>
                                            <Line startX="-150" startY="-100" endX="-120" endY="-100" stroke="#2F6BFF" strokeWidth="3" />
                                        </Group>

                                        <!-- QR-like finder patterns and modules -->
                                        <Group>
                                            <!-- Finder: top-left -->
                                            <Rectangle x="36" y="36" width="56" height="56" fill="#2F6BFF" />
                                            <Rectangle x="46" y="46" width="36" height="36" fill="white" />
                                            <Rectangle x="56" y="56" width="16" height="16" fill="#2F6BFF" />

                                            <!-- Finder: top-right -->
                                            <Rectangle x="228" y="36" width="56" height="56" fill="#2F6BFF" />
                                            <Rectangle x="238" y="46" width="36" height="36" fill="white" />
                                            <Rectangle x="248" y="56" width="16" height="16" fill="#2F6BFF" />

                                            <!-- Finder: bottom-left -->
                                            <Rectangle x="36" y="140" width="56" height="56" fill="#2F6BFF" />
                                            <Rectangle x="46" y="150" width="36" height="36" fill="white" />
                                            <Rectangle x="56" y="160" width="16" height="16" fill="#2F6BFF" />

                                            <!-- scattered QR-like modules (more randomized positions) -->
                                            <Rectangle x="112" y="68" width="9" height="9" fill="#2F6BFF" />
                                            <Rectangle x="119" y="78" width="7" height="7" fill="#2F6BFF" />
                                            <Rectangle x="132" y="66" width="10" height="10" fill="#2F6BFF" />
                                            <Rectangle x="145" y="74" width="8" height="8" fill="#2F6BFF" />
                                            <Rectangle x="157" y="64" width="9" height="9" fill="#2F6BFF" />
                                            <Rectangle x="168" y="82" width="7" height="7" fill="#2F6BFF" />

                                            <Rectangle x="124" y="90" width="8" height="8" fill="#2F6BFF" />
                                            <Rectangle x="137" y="98" width="9" height="9" fill="#2F6BFF" />
                                            <Rectangle x="151" y="86" width="6" height="6" fill="#2F6BFF" />
                                            <Rectangle x="164" y="100" width="8" height="8" fill="#2F6BFF" />

                                            <Rectangle x="176" y="72" width="7" height="7" fill="#2F6BFF" />
                                            <Rectangle x="186" y="92" width="10" height="10" fill="#2F6BFF" />
                                            <Rectangle x="196" y="78" width="6" height="6" fill="#2F6BFF" />
                                            <Rectangle x="208" y="88" width="8" height="8" fill="#2F6BFF" />

                                            <Rectangle x="120" y="110" width="9" height="9" fill="#2F6BFF" />
                                            <Rectangle x="132" y="118" width="7" height="7" fill="#2F6BFF" />
                                            <Rectangle x="142" y="126" width="8" height="8" fill="#2F6BFF" />

                                            <Rectangle x="158" y="132" width="6" height="6" fill="#2F6BFF" />
                                            <Rectangle x="174" y="108" width="7" height="7" fill="#2F6BFF" />
                                            <Rectangle x="190" y="118" width="9" height="9" fill="#2F6BFF" />

                                            <Rectangle x="202" y="100" width="7" height="7" fill="#2F6BFF" />
                                            <Rectangle x="214" y="124" width="8" height="8" fill="#2F6BFF" />
                                            <Rectangle x="108" y="130" width="8" height="8" fill="#2F6BFF" />
                                            <Rectangle x="124" y="140" width="7" height="7" fill="#2F6BFF" />
                                        </Group>

                                        <!-- optional scan line (subtle) -->
                                        <Rectangle fx:id="scanLine" width="300" height="2" fill="#2F6BFF" opacity="0.12" />
                                    </children>
                                </StackPane>

                                <!-- Controls area (Pause checkbox + helper) -->
                                <VBox spacing="10" alignment="TOP_LEFT" styleClass="scanner-controls">
                                    <children>
                                        <CheckBox text="Pauza" fx:id="pauseCheckbox" styleClass="input" />
                                        <Label text="Označite ako prijavljujete ili odjavljujete pauzu." wrapText="true" maxWidth="240" styleClass="helper-text" />
                                    </children>
                                </VBox>
                            </HBox>

                        </children>
                    </VBox>
                </children>
            </AnchorPane>
        </children>
    </StackPane>
</VBox>
