<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox spacing="10" alignment="CENTER" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.ui.controller.LoginController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <Label text="Evidencija prisustva" style="-fx-font-size:18px; -fx-font-weight:bold;" />
    <TextField fx:id="usernameField" promptText="Korisničko ime" />
    <PasswordField fx:id="passwordField" promptText="Lozinka" />
    <Button text="Prijava" fx:id="loginButton" onAction="#onLogin" />
    <Label fx:id="messageLabel" />
</VBox>

