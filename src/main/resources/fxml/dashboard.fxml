<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.ui.controller.DashboardController" styleClass="page-root">

    <left>
        <!-- Vertical sidebar navigation -->
        <VBox fx:id="sidebar" spacing="8" prefWidth="220" styleClass="sidebar">
            <children>
                <!-- Logo at top of sidebar -->
                <HBox alignment="CENTER" styleClass="sidebar-logo">
                    <ImageView fx:id="inputLogo" fitWidth="160" fitHeight="60" preserveRatio="true" pickOnBounds="true" />
                </HBox>

                <HBox spacing="8" alignment="CENTER_LEFT" styleClass="nav-item">
                    <Region styleClass="nav-accent" />
                    <Button fx:id="menuDashboard" text="Dashboard" onAction="#onMenuDashboard" styleClass="nav-button" HBox.hgrow="ALWAYS" />
                </HBox>

                <HBox spacing="8" alignment="CENTER_LEFT" styleClass="nav-item">
                    <Region styleClass="nav-accent" />
                    <Button fx:id="menuUsers" text="Korisnici" onAction="#onMenuUsers" styleClass="nav-button" HBox.hgrow="ALWAYS" />
                </HBox>

                <HBox spacing="8" alignment="CENTER_LEFT" styleClass="nav-item">
                    <Region styleClass="nav-accent" />
                    <Button fx:id="menuAttendance" text="Prisustva" onAction="#onMenuAttendance" styleClass="nav-button" HBox.hgrow="ALWAYS" />
                </HBox>

                <Region VBox.vgrow="ALWAYS" />

                <HBox spacing="8" alignment="CENTER_LEFT" styleClass="nav-item">
                    <Region styleClass="nav-accent" />
                    <Button fx:id="menuLogout" text="Logout" onAction="#onLogout" styleClass="nav-button" HBox.hgrow="ALWAYS" />
                </HBox>
            </children>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentPane">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
        </StackPane>
    </center>

</BorderPane>
